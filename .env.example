# Env contract for the Relaticle stack. These values live in Coolify (app →
# Environment Variables), not in this repo. Copy to .env only for a local run;
# .env is gitignored.

# Pinned upstream release. Bump deliberately, then push.
RELATICLE_VERSION=3.8.0

# Public origin: scheme + host, no trailing slash. The app rejects any Host
# header that is neither this host nor in TRUSTED_HOSTS.
APP_URL=https://crm.forefrontinvestors.com

# Extra accepted hosts, comma separated. The container health check calls
# localhost:8080/up, so localhost has to stay in this list.
TRUSTED_HOSTS=localhost

APP_NAME=Relaticle
APP_TIMEZONE=America/New_York

# openssl rand -base64 32, then prefix with base64: — Laravel's encryption key.
# Losing it makes encrypted custom fields unreadable.
APP_KEY=

# Postgres, created by the compose stack on first boot.
DB_DATABASE=relaticle
DB_USERNAME=relaticle
# openssl rand -hex 32
DB_PASSWORD=

# Signs messages between the app, the workers and the reverb websocket.
# openssl rand -hex 32 — independent of APP_KEY so it can be rotated alone.
REVERB_APP_SECRET=

LOG_LEVEL=warning

# Mail. `log` writes messages to the container log instead of sending them;
# reminder emails and invites need `smtp`. Purelymail takes port 587 with TLS
# and the mailbox password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.purelymail.com
MAIL_PORT=587
MAIL_USERNAME=josh@forefrontinvestors.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=josh@forefrontinvestors.com
MAIL_FROM_NAME=Relaticle
